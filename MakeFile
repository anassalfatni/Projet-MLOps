# =========================================================
# Makefile - Pipeline MLOps Analyse de sentiment DistilBERT
# =========================================================

VENV       := venv
PYTHON     := $(VENV)/bin/python
PIP        := $(VENV)/bin/pip
STREAMLIT  := $(VENV)/bin/streamlit
CONFIG     := config.yaml

.PHONY: help venv install data preprocess train evaluate deploy run pipeline \
        docker-build docker-run clean

help:
	@echo "Cibles disponibles :"
	@echo "  make venv          - crée l'environnement virtuel"
	@echo "  make install       - installe les dépendances"
	@echo "  make data          - télécharge le dataset brut"
	@echo "  make preprocess    - tokenize le dataset"
	@echo "  make train         - entraîne le modèle"
	@echo "  make evaluate      - évalue le modèle sur le test set"
	@echo "  make deploy        - publie le modèle sur le Hugging Face Hub"
	@echo "  make pipeline      - enchaîne data -> preprocess -> train -> evaluate"
	@echo "  make run           - lance l'app Streamlit"
	@echo "  make docker-build  - build l'image Docker"
	@echo "  make docker-run    - lance le conteneur Docker"
	@echo "  make clean         - supprime les artefacts générés"

venv:
	python3 -m venv $(VENV)

install: venv
	$(PIP) install --upgrade pip
	$(PIP) install -r requirements.txt

data:
	$(PYTHON) src/get_data.py --config $(CONFIG)

preprocess:
	$(PYTHON) src/preprocess.py --config $(CONFIG)

train:
	$(PYTHON) src/train.py --config $(CONFIG)

evaluate:
	$(PYTHON) src/evaluate.py --config $(CONFIG)

deploy:
	$(PYTHON) src/deploy.py --config $(CONFIG)

pipeline: data preprocess train evaluate

run:
	$(STREAMLIT) run src/app.py

docker-build:
	docker build -t sentiment-app .

docker-run:
	docker run -p 8501:8501 sentiment-app

clean:
	rm -rf data/raw data/processed models reports tmp_eval
	find . -type d -name "__pycache__" -exec rm -rf {} +